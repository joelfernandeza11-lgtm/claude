# Oficina de Producto (/oficina)

# Obligatorio para búsquedas reales. https://console.anthropic.com
# La búsqueda web debe estar habilitada en tu organización de Anthropic (Console > Settings > Privacy).
ANTHROPIC_API_KEY=

# Opcional: modelo a usar (default: claude-opus-5-5). claude-sonnet-5-5 es más rápido y barato.
# OFICINA_MODEL=claude-sonnet-5-5

# Opcional pero recomendado si publicás la app: cada búsqueda consume créditos de API.
# Si lo definís, la UI pide este código antes de buscar.
# OFICINA_ACCESS_CODE=
